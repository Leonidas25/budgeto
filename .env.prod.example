# Production Environment Configuration
# Copy this file to .env.prod and fill in the values for production deployment

# Database Configuration
POSTGRES_DB=budgeto_prod
POSTGRES_USER=budgeto_user
POSTGRES_PASSWORD=your_secure_database_password_here

# Backend Security
JWT_SECRET_KEY=your_jwt_secret_key_here_min_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# Frontend Configuration
NEXT_PUBLIC_API_URL=https://your-domain.com/api

# CORS Configuration (add your domain)
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Application Environment
ENVIRONMENT=production
LOG_LEVEL=INFO
DEBUG=false

# Gunicorn Configuration
WORKERS=4
WORKER_CONNECTIONS=1000
MAX_REQUESTS=1000
MAX_REQUESTS_JITTER=100
TIMEOUT=30
KEEP_ALIVE=5

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=900

# Telegram Bot (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here

# Monitoring (Optional)
SENTRY_DSN=your_sentry_dsn_here
GRAFANA_ADMIN_PASSWORD=your_grafana_admin_password_here

# Build Information (for CI/CD)
BUILD_DATE=2024-01-01T00:00:00Z
VCS_REF=main
VERSION=1.0.0