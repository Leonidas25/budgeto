# Production Dockerfile for Budgeto Backend API
# Multi-stage build for optimized production image

# Build stage
FROM python:3.11-slim as builder

# Set build arguments
ARG BUILD_DATE
ARG VCS_REF
ARG VERSION

# Add metadata
LABEL maintainer="budgeto-team@example.com" \
      org.opencontainers.image.created=$BUILD_DATE \
      org.opencontainers.image.url="https://github.com/your-org/budgeto" \
      org.opencontainers.image.source="https://github.com/your-org/budgeto" \
      org.opencontainers.image.version=$VERSION \
      org.opencontainers.image.revision=$VCS_REF \
      org.opencontainers.image.vendor="Budgeto Team" \
      org.opencontainers.image.title="Budgeto Backend API" \
      org.opencontainers.image.description="Secure budget management API for Greek students"

# Install system dependencies for building
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy requirements first for better caching
COPY requirements.txt requirements-prod.txt ./

# Create virtual environment and install dependencies
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Upgrade pip and install dependencies
RUN pip install --upgrade pip \
    && pip install --no-cache-dir -r requirements-prod.txt

# Production stage
FROM python:3.11-slim as production

# Install runtime dependencies only
RUN apt-get update && apt-get install -y \
    libpq5 \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create non-root user for security
RUN groupadd -r budgeto && \
    useradd -r -g budgeto -s /bin/false -c "Budgeto API User" budgeto

# Copy virtual environment from builder stage
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Set working directory
WORKDIR /app

# Copy application code
COPY --chown=budgeto:budgeto . .

# Create necessary directories with proper permissions
RUN mkdir -p /app/logs /app/uploads /tmp/budgeto && \
    chown -R budgeto:budgeto /app /tmp/budgeto

# Remove unnecessary files for production
RUN rm -rf tests/ __pycache__/ *.pyc *.pyo *.pyd .git/ .pytest_cache/ \
    && find . -type d -name __pycache__ -exec rm -rf {} + \
    && find . -type f -name "*.pyc" -delete

# Security: Remove package manager and build tools
RUN apt-get purge -y --auto-remove build-essential

# Set environment variables for production
ENV PYTHONPATH=/app \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONHASHSEED=random \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    ENVIRONMENT=production \
    LOG_LEVEL=INFO

# Security: Set file permissions
RUN chmod -R 755 /app && \
    chmod -R 750 /app/logs && \
    chmod +x /app/start.sh

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Expose port
EXPOSE 8000

# Switch to non-root user
USER budgeto

# Add startup script
COPY --chown=budgeto:budgeto start.sh /app/start.sh

# Run application
CMD ["/app/start.sh"]